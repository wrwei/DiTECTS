-- REQ-ADS-007: an accepted power-loss input must be followed by the fail-safe
-- entry action before another controller input. This is an untimed protocol.
ADS_ResponseEvents = {ADSController::powerLoss.in, ADSController::dewpointHigh.in,
  ADSController::changeoverComplete.in, ADSController::backupRestored.in,
  ADSController::enterFailSafe.out}

ADS_ResponseNormal = ADSController::powerLoss.in -> ADS_ResponsePending
  [] ADSController::dewpointHigh.in -> ADS_ResponseChangeover
ADS_ResponseChangeover = ADSController::powerLoss.in -> ADS_ResponsePending
  [] ADSController::changeoverComplete.in -> ADS_ResponseNormal
ADS_ResponsePending = ADSController::enterFailSafe.out -> ADS_ResponseFailSafe
ADS_ResponseFailSafe = ADSController::backupRestored.in -> ADS_ResponseNormal

-- Block external shutdown and memory writes; hide the remaining finite actions.
ADS_ResponseView =
  (P_ADSController [| {|ADSController::terminate, ADSController::set_EXT_activeDryer|} |] STOP)
    \ diff(ADSController::sem__events, ADS_ResponseEvents)

assert ADS_ResponseNormal [FD= ADS_ResponseView

-- REQ-ADS-006: the first and every later completed changeover select the
-- other bed. Retain controller inputs so unrelated input loops stay visible.
ADS_OtherBed(d) = if d == Dryer_BedA then Dryer_BedB else Dryer_BedA
ADS_AlternationStart(d) = ADSController::powerLoss.in -> ADS_BedFailSafe(d)
  [] ADSController::dewpointHigh.in -> ADS_BedChangeover(d)
ADS_BedChangeover(d) = ADSController::powerLoss.in -> ADS_BedFailSafe(d)
  [] ADSController::changeoverComplete.in ->
       ADSController::set_activeDryer!ADS_OtherBed(d) ->
       ADS_AlternationStart(ADS_OtherBed(d))
ADS_BedFailSafe(d) = ADSController::backupRestored.in -> ADS_AlternationStart(d)

ADS_AlternationView =
  (P_ADSController [| {|ADSController::terminate, ADSController::set_EXT_activeDryer|} |] STOP)
    \ diff(ADSController::sem__events,
            union({ADSController::powerLoss.in, ADSController::dewpointHigh.in,
                   ADSController::changeoverComplete.in, ADSController::backupRestored.in},
                  {|ADSController::set_activeDryer|}))

assert ADS_AlternationStart(ADS_InitialBed) [FD= ADS_AlternationView

